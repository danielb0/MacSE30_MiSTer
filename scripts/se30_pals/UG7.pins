# UG7  341-0746-A  16R8  sheet 5 "video interface" - horizontal timing
1=C16M        # clock: the 15.6672 MHz pixel clock
2=CNT0        # UG8 LS393 horizontal counter, clocked by C2M
3=CNT1
4=CNT2
5=CNT3
6=CNT4
7=CNT5
8=CNT6
9=VIDTIME     # from UG6: inside the active frame
11=PD1        # /OE, pulled down: outputs always enabled
12=TWOLINE    # clock to UF8, the line-pair counter
13=HSYNC*
14=SREGLD     # parallel load of UE8, the pixel shift register
15=SC         # serial clock to the VRAMs' serial ports
16=C2M        # C16M/8, one count per byte of pixels; clocks UG8
17=Q3int      # not wired: internal state
18=Q2int      # not wired: internal state
19=HCTRRST    # clear (active-high) of UG8
