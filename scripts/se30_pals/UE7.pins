# UE7  341-0755-A  16R8  sheet 5 "video interface" - slot-E access state machine
1=C16M
2=nc2         # not wired
3=HSYNC*
4=SLTE/F      # UJ6 74LS30: A31-A25 all ones (slot $E or $F space)
5=A24         # 0 = $FE (slot E), 1 = $FF
6=NUBUS*      # GLUE's slot-space select
7=nc7
8=nc8
9=VIDTIME
11=PD8        # /OE pulled down
12=VID/V
13=VIDS0      # state bits, to UE6
14=VIDS1
15=VIDS2
16=VIDS3
17=VIDS4
18=VR*
19=VIDREQ     # to UE6
