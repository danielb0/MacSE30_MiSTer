set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"

set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SAVE_DISK_SPACE OFF
set_global_assignment -name SMART_RECOMPILE ON
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name TIMEQUEST_MULTICORNER_ANALYSIS ON
set_global_assignment -name OPTIMIZE_POWER_DURING_FITTING OFF
set_global_assignment -name FINAL_PLACEMENT_OPTIMIZATION ALWAYS
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE ON
set_global_assignment -name QII_AUTO_PACKED_REGISTERS NORMAL
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name MUX_RESTRUCTURE ON
set_global_assignment -name REMOVE_REDUNDANT_LOGIC_CELLS ON
set_global_assignment -name AUTO_DELAY_CHAINS_FOR_HIGH_FANOUT_INPUT_PINS ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC_FOR_AREA ON
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP ON
set_global_assignment -name SYNTH_GATED_CLOCK_CONVERSION ON
set_global_assignment -name PRE_MAPPING_RESYNTHESIS ON
set_global_assignment -name ROUTER_CLOCKING_TOPOLOGY_ANALYSIS ON
set_global_assignment -name ECO_OPTIMIZE_TIMING ON
set_global_assignment -name PERIPHERY_TO_CORE_PLACEMENT_AND_ROUTING_OPTIMIZATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING ON
set_global_assignment -name ALM_REGISTER_PACKING_EFFORT MEDIUM
set_global_assignment -name SEED 1

#set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"

#enable it only if 8bit indexed mode is used in core
#set_global_assignment -name VERILOG_MACRO "MISTER_FB_PALETTE=1"

#do not enable DEBUG_NOHDMI in release!
#set_global_assignment -name VERILOG_MACRO "MISTER_DEBUG_NOHDMI=1"

# disable bilinear filtering when downscaling
#set_global_assignment -name VERILOG_MACRO "MISTER_DOWNSCALE_NN=1"

# disable adaptive scanline filtering
#set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ADAPTIVE=1"

#use only 1MB per frame for scaler to free ~21MB DDR3 RAM
#set_global_assignment -name VERILOG_MACRO "MISTER_SMALL_VBUF=1"

# Disable YC / Composite output to save some resources
#set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_YC=1"

# Disable ALSA audio output to save some resources
#set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"

# The bring-up probe deck (rtl/dbg_probes.sv, read with scripts/read_probes.tcl
# over JTAG): PBLD PIFA PLAS PSTA PACT.  Leave it in until the machine boots;
# strip it for a release build (SE30_PLAN.md 3.5).  Without this line the deck
# is not compiled in - compiles 1-3 of 2026-09-27 had no probes.
#set_global_assignment -name VERILOG_MACRO "USE_DBG_PROBES=1"
# The Macintosh IIcx build (SE30_PLAN.md Section 14): the shared tree with
# The Macintosh IIci (SE30_PLAN.md "THE MacIIci TOP AND ITS SDRAM"): MacIIci.sv,
# files_iici.qip, MacIIci.sdc; the PLL's placement rules as the IIcx's (KNOWN ISSUES 24).
# SE30_PLAN.md 3.8 item 18: the SDRAM read capture is timed at chain zero
# (the phases were placed with no input delay chain); the fitter would
# otherwise tune the chains for a capture it cannot see (MacSE30.sdc)
set_instance_assignment -name D1_DELAY 0 -to SDRAM_DQ[*]
# The core's clocks on GLOBAL networks, said outright: compile 7 (2026-09-27)
# let the fitter choose and it put clk_mem on a regional one, which reaches
# one quadrant, so the SDRAM_DQ output and output-enable registers on pins
# outside it could not pack into their I/O cells and the outputs to the chip
# lost 4 ns of setup.  The capture clock is global by its clock control
# block's own setting.
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to "emu|pll|pll_inst|altera_pll_i|outclk_wire[0]"
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to "emu|pll|pll_inst|altera_pll_i|outclk_wire[1]"
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to "emu|pll|pll_inst|altera_pll_i|outclk_wire[2]"
# The IIci's clk_k (the CPU kernel, ~8,800 registers) and clk_vid on global
# clocks too: the first compile (2026-11-13) left them regional - the kernel
# confined to one quadrant (the router's congestion was inside it) and
# skewed against clk_sys (3 ns of hold padding per clk_k <-> clk_sys path):
# it did not route.
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to "emu|pll|pll_inst|altera_pll_i|outclk_wire[5]"
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to "emu|pll|pll_inst|altera_pll_i|outclk_wire[6]"
# KNOWN ISSUES 24: the framework's pll_cfg_hdmi writes Main's HDMI divider to
# physical counter C5 and nowhere else, and pll_hdmi reaches the HDMI clock
# switch from C5 only at FRACTIONALPLL_X0_Y1 (every other core's site).  The
# IIcx fits of 2026-10 put it in the PLL strip (X0_Y32, output on C8) and
# every HDMI mode but 1080p broke.  Pinned, so no fit can move it again.
set_location_assignment FRACTIONALPLL_X0_Y1_N0 -to "pll_hdmi:pll_hdmi|pll_hdmi_0002:pll_hdmi_inst|altera_pll:altera_pll_i|altera_cyclonev_pll:cyclonev_pll|altera_cyclonev_pll_base:fpll_0|fpll"
set_location_assignment PLLOUTPUTCOUNTER_X0_Y5_N1 -to "pll_hdmi:pll_hdmi|pll_hdmi_0002:pll_hdmi_inst|altera_pll:altera_pll_i|altera_cyclonev_pll:cyclonev_pll|counter[0].output_counter"


# The read capture's first fabric registers (rtl/iici_sdram.v dq_w) beside their pins:
# at 150 MHz the I/O cell -> fabric hop has one 6.67 ns period, and the first full
# compile (2026-11-13) left three bits' registers far from their pins (-1.6 ns).  The
# SDRAM_DQ pins sit along the bottom (Y0) and top (Y81) edges at X 8-82: one small
# region per group of neighbouring pins (the fit report's pin coordinates).
set_global_assignment -name LL_ENABLED ON -section_id dqw_b8
set_global_assignment -name LL_AUTO_SIZE OFF -section_id dqw_b8
set_global_assignment -name LL_STATE LOCKED -section_id dqw_b8
set_global_assignment -name LL_RESERVED OFF -section_id dqw_b8
set_global_assignment -name LL_CORE_ONLY OFF -section_id dqw_b8
set_global_assignment -name LL_WIDTH 6 -section_id dqw_b8
set_global_assignment -name LL_HEIGHT 3 -section_id dqw_b8
set_global_assignment -name LL_ORIGIN X6_Y1 -section_id dqw_b8
set_instance_assignment -name LL_MEMBER_OF dqw_b8 -to "emu:emu|iici_sdram:sdram|dq_w[10]" -section_id dqw_b8
set_instance_assignment -name LL_MEMBER_OF dqw_b8 -to "emu:emu|iici_sdram:sdram|dq_w[13]" -section_id dqw_b8
set_global_assignment -name LL_ENABLED ON -section_id dqw_b34
set_global_assignment -name LL_AUTO_SIZE OFF -section_id dqw_b34
set_global_assignment -name LL_STATE LOCKED -section_id dqw_b34
set_global_assignment -name LL_RESERVED OFF -section_id dqw_b34
set_global_assignment -name LL_CORE_ONLY OFF -section_id dqw_b34
set_global_assignment -name LL_WIDTH 20 -section_id dqw_b34
set_global_assignment -name LL_HEIGHT 3 -section_id dqw_b34
set_global_assignment -name LL_ORIGIN X24_Y1 -section_id dqw_b34
set_instance_assignment -name LL_MEMBER_OF dqw_b34 -to "emu:emu|iici_sdram:sdram|dq_w[14]" -section_id dqw_b34
set_instance_assignment -name LL_MEMBER_OF dqw_b34 -to "emu:emu|iici_sdram:sdram|dq_w[7]" -section_id dqw_b34
set_instance_assignment -name LL_MEMBER_OF dqw_b34 -to "emu:emu|iici_sdram:sdram|dq_w[15]" -section_id dqw_b34
set_instance_assignment -name LL_MEMBER_OF dqw_b34 -to "emu:emu|iici_sdram:sdram|dq_w[0]" -section_id dqw_b34
set_instance_assignment -name LL_MEMBER_OF dqw_b34 -to "emu:emu|iici_sdram:sdram|dq_w[3]" -section_id dqw_b34
set_global_assignment -name LL_ENABLED ON -section_id dqw_b60
set_global_assignment -name LL_AUTO_SIZE OFF -section_id dqw_b60
set_global_assignment -name LL_STATE LOCKED -section_id dqw_b60
set_global_assignment -name LL_RESERVED OFF -section_id dqw_b60
set_global_assignment -name LL_CORE_ONLY OFF -section_id dqw_b60
set_global_assignment -name LL_WIDTH 8 -section_id dqw_b60
set_global_assignment -name LL_HEIGHT 3 -section_id dqw_b60
set_global_assignment -name LL_ORIGIN X58_Y1 -section_id dqw_b60
set_instance_assignment -name LL_MEMBER_OF dqw_b60 -to "emu:emu|iici_sdram:sdram|dq_w[4]" -section_id dqw_b60
set_instance_assignment -name LL_MEMBER_OF dqw_b60 -to "emu:emu|iici_sdram:sdram|dq_w[12]" -section_id dqw_b60
set_instance_assignment -name LL_MEMBER_OF dqw_b60 -to "emu:emu|iici_sdram:sdram|dq_w[6]" -section_id dqw_b60
set_global_assignment -name LL_ENABLED ON -section_id dqw_b80
set_global_assignment -name LL_AUTO_SIZE OFF -section_id dqw_b80
set_global_assignment -name LL_STATE LOCKED -section_id dqw_b80
set_global_assignment -name LL_RESERVED OFF -section_id dqw_b80
set_global_assignment -name LL_CORE_ONLY OFF -section_id dqw_b80
set_global_assignment -name LL_WIDTH 12 -section_id dqw_b80
set_global_assignment -name LL_HEIGHT 3 -section_id dqw_b80
set_global_assignment -name LL_ORIGIN X74_Y1 -section_id dqw_b80
set_instance_assignment -name LL_MEMBER_OF dqw_b80 -to "emu:emu|iici_sdram:sdram|dq_w[9]" -section_id dqw_b80
set_instance_assignment -name LL_MEMBER_OF dqw_b80 -to "emu:emu|iici_sdram:sdram|dq_w[8]" -section_id dqw_b80
set_instance_assignment -name LL_MEMBER_OF dqw_b80 -to "emu:emu|iici_sdram:sdram|dq_w[11]" -section_id dqw_b80
set_global_assignment -name LL_ENABLED ON -section_id dqw_t35
set_global_assignment -name LL_AUTO_SIZE OFF -section_id dqw_t35
set_global_assignment -name LL_STATE LOCKED -section_id dqw_t35
set_global_assignment -name LL_RESERVED OFF -section_id dqw_t35
set_global_assignment -name LL_CORE_ONLY OFF -section_id dqw_t35
set_global_assignment -name LL_WIDTH 12 -section_id dqw_t35
set_global_assignment -name LL_HEIGHT 3 -section_id dqw_t35
set_global_assignment -name LL_ORIGIN X30_Y78 -section_id dqw_t35
set_instance_assignment -name LL_MEMBER_OF dqw_t35 -to "emu:emu|iici_sdram:sdram|dq_w[2]" -section_id dqw_t35
set_instance_assignment -name LL_MEMBER_OF dqw_t35 -to "emu:emu|iici_sdram:sdram|dq_w[1]" -section_id dqw_t35
set_instance_assignment -name LL_MEMBER_OF dqw_t35 -to "emu:emu|iici_sdram:sdram|dq_w[5]" -section_id dqw_t35

source sys/sys.tcl
source sys/sys_analog.tcl
source files_iici.qip
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top