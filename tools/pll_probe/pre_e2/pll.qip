# The core's one PLL (SE30_PLAN.md 3.2): written by hand in the shape the
# Altera PLL wizard emits, so Quartus computes the counters from the two
# frequencies in pll/pll_0002.v.
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) pll.v ]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) pll/pll_0002.v ]
